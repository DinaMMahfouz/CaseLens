# Copy to .env and fill in. Never commit .env.

# Keyed pseudonyms for account/engineer labels (ACCT-xxxx, TSE-xxxx).
# REQUIRED when data_source.synthetic is false. Use a long random value.
CASEQA_PSEUDONYM_KEY=

# Supabase (local worker only - NEVER put the secret key in the frontend or on Vercel).
# Dashboard > Project Settings > API Keys > Secret keys.
SUPABASE_URL=https://ipzlkcejuxilzyphdmgy.supabase.co
SUPABASE_SECRET_KEY=

# LLM provider secrets (only the one selected in config/app.yaml is used)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://localhost:11434

# Database (SQLite default; Postgres example: postgresql+psycopg://user:pass@host/caseqa)
# DATABASE_URL=sqlite:///var/caseqa.db
